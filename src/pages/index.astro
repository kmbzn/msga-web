---
import Layout from '../layouts/Layout.astro'; import Header from '../components/Header.astro'; import Hero from '../components/Hero.astro'; import Partners from '../components/Partners.astro'; import Business from '../components/Business.astro'; import About from '../components/About.astro'; import Projects from '../components/Projects.astro'; import Technology from '../components/Technology.astro'; import CTA from '../components/CTA.astro'; import Footer from '../components/Footer.astro';
---
<Layout><Header/><main><Hero/><Partners/><Business/><About/><Projects/><Technology/><CTA/></main><Footer/></Layout>
<script>
  import Lenis from 'lenis'; import { gsap } from 'gsap'; import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const lenis = new Lenis({ lerp: .09, smoothWheel: true });
  lenis.on('scroll', ScrollTrigger.update); gsap.ticker.add(t => lenis.raf(t * 1000)); gsap.ticker.lagSmoothing(0);
  document.querySelectorAll('.reveal').forEach(el => gsap.fromTo(el,{opacity:0,y:55,filter:'blur(15px)'},{opacity:1,y:0,filter:'blur(0px)',duration:1.1,ease:'power3.out',scrollTrigger:{trigger:el,start:'top 88%'}}));
  document.querySelectorAll('.image-reveal').forEach(el => { gsap.fromTo(el,{clipPath:'inset(12% 0 0 0)',scale:1.05},{clipPath:'inset(0 0 0 0)',scale:1,duration:1.35,ease:'power4.out',scrollTrigger:{trigger:el,start:'top 88%'}}); });
  gsap.to('.graphic-one',{y:180,rotation:18,scrollTrigger:{trigger:'.hero',start:'top top',end:'bottom top',scrub:1}}); gsap.to('.hero-visual',{y:-38,scrollTrigger:{trigger:'.hero',start:'top top',end:'bottom top',scrub:1}});
  ScrollTrigger.create({start:40,onUpdate:s=>document.querySelector('.site-header')?.classList.toggle('is-scrolled',s.scroll()>40)});
  document.querySelectorAll('[data-count]').forEach(el=>{let target=Number(el.dataset.count); ScrollTrigger.create({trigger:el,start:'top 85%',once:true,onEnter:()=>gsap.fromTo({n:0},{n:0},{n:target,duration:1.3,ease:'power2.out',onUpdate:function(){el.textContent=Math.floor(this.targets()[0].n)+(target===20?'+':'')}})})});
  document.querySelector('.menu')?.addEventListener('click',()=>document.querySelector('.nav-links')?.classList.toggle('open'));
</script>
