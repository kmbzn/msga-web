---
import '../styles/global.css';
import { company } from '../data/site';
const { title = `${company.name} — ${company.slogan}` } = Astro.props;
---
<!doctype html><html lang="ko"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content="MSGA는 기술과 데이터, 인프라를 연결해 다음 환경을 설계합니다." /><title>{title}</title></head><body><slot /></body></html>
